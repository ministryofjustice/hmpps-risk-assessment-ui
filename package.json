{
  "name": "risk-assessment-ui",
  "description": "HMPPS UI Service",
  "repository": "git@github.com:ministryofjustice/hmpps-risk-assessment-ui.git",
  "version": "0.0.1",
  "license": "MIT",
  "engines": {
    "node": "^24.0.0",
    "npm": "^11.0.0"
  },
  "jest": {
    "setupFilesAfterEnv": [
      "./test-helpers/setup.js"
    ],
    "collectCoverageFrom": [
      "common/**/*.js"
    ],
    "testMatch": [
      "<rootDir>/(common)/**/?(*.)(test).js",
      "<rootDir>/(app)/**/?(*.)(test).js"
    ],
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js"
    ]
  },
  "scripts": {
    "build": "npm run clean && npm run build:copy && npm run build:css && npm run build:js",
    "clean": "rm -rf dist && mkdir dist",
    "build:copy": "npm run copy-assets",
    "build:css": "sass --quiet-deps --no-source-map --load-path=node_modules --load-path=node_modules/govuk-frontend/dist --load-path=node_modules/@ministryofjustice/frontend --load-path=. assets/sass/application.scss:dist/stylesheets/application.min.css --style compressed",
    "build:js": "esbuild assets/javascripts/browsered/index.js --bundle --minify --target=es2018 --outfile=dist/javascripts/application.js",
    "copy-assets": "ncp assets/javascripts/ dist/javascripts/ --filter=.* && ncp assets/images/ dist/images/ --filter=.*",
    "security_audit": "npm audit",
    "start": "node ./start.js",
    "start:dev": "npm run build && node ./start.js",
    "lint-sass": "stylelint '**/*.scss'",
    "lint-sass:fix": "stylelint '**/*.scss' --fix",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --forceExit",
    "test:ci": "NODE_OPTIONS=--experimental-vm-modules jest --runInBand",
    "lint": "eslint . --cache --max-warnings 0 && stylelint '**/*.scss' --cache --max-warnings 0",
    "lint-staged": "lint-staged",
    "lint:fix": "eslint . --cache --fix && stylelint '**/*.scss' --cache --fix",
    "watch:sass": "sass --watch --quiet-deps --no-source-map --load-path=node_modules --load-path=node_modules/govuk-frontend/dist --load-path=node_modules/@ministryofjustice/frontend --load-path=. assets/sass/application.scss:dist/stylesheets/application.min.css --style compressed",
    "record-build-info": "node ./bin/record-build-info",
    "postinstall": "patch-package",
    "setup": "npm ci && hmpps-npm-script-run-allowlist && patch-package && cypress install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-sns": "^3.1161.0",
    "@microsoft/opentelemetry": "1.5.0",
    "@ministryofjustice/frontend": "12.0.0",
    "@opentelemetry/api-logs": "0.221.0",
    "agentkeepalive": "^4.6.0",
    "async": "^3.2.6",
    "body-parser": "^2.4.0",
    "cls-hooked": "^4.2.2",
    "compression": "^1.8.2",
    "connect-redis": "^9.0.0",
    "continuation-local-storage": "^3.2.1",
    "cookie-parser": "^1.4.7",
    "cypress-split": "^1.25.0",
    "dotenv": "^17.0.0",
    "express": "^5.3.0",
    "express-jwt": "^8.5.1",
    "express-session": "^1.18.2",
    "govuk-frontend": "6.6.0",
    "helmet": "^8.1.0",
    "hmpo-form-wizard": "^18.2.0",
    "json-web-token": "^4.0.1",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.0.1",
    "jwt-decode": "^4.0.0",
    "lodash": "^4.18.1",
    "luxon": "^3.6.1",
    "minimist": "^1.2.8",
    "morgan": "1.12.1",
    "nunjucks": "^3.2.4",
    "nunjucks-date-filter": "^0.1.1",
    "passport": "^0.7.0",
    "passport-oauth2": "^1.8.0",
    "passport-oauth2-refresh": "^2.0.2",
    "patch-package": "^8.0.0",
    "redis": "^5.1.0",
    "sanitize-html": "^2.18.1",
    "serve-favicon": "^2.5.0",
    "superagent": "^10.2.1",
    "throng": "^5.0.0",
    "uuid": "^11.1.0",
    "winston": "^3.17.0"
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "@ministryofjustice/eslint-config-hmpps": "^2.0.0-alpha.2",
    "@ministryofjustice/hmpps-npm-script-allowlist": "0.0.3",
    "@types/luxon": "^3.6.2",
    "@types/supertest": "7.2.1",
    "audit-ci": "^7.1.0",
    "chokidar": "^3.6.0",
    "cypress": "^15.0.0",
    "cypress-axe": "^1.6.0",
    "cypress-on-fix": "^1.1.0",
    "cypress-plugin-tab": "^1.0.5",
    "cypress-terminal-report": "^7.2.0",
    "cypress-visual-regression": "^5.2.2",
    "cypress-wait-until": "^3.0.2",
    "envfile": "^7.1.0",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "mocha-junit-reporter": "^2.2.1",
    "nanoid": "^6.0.2",
    "ncp": "^2.0.0",
    "nock": "^14.0.4",
    "prettier": "^3.5.3",
    "redis-mock": "^0.56.3",
    "sass": "^1.89.0",
    "set-value": ">=4.1.0",
    "stylelint": "^17.16.0",
    "stylelint-config-recommended": "^18.0.0",
    "stylelint-config-standard": "^40.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.4.0",
    "supertest": "^7.1.1",
    "tar": ">=7.5.4"
  },
  "lint-staged": {
    "*.{js,json,css}": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.scss": [
      "stylelint '**/*.scss' --cache --fix"
    ]
  },
  "cypress-cucumber-preprocessor": {
    "nonGlobalStepDefinitions": false,
    "stepDefinitions": [
      "integration_tests/support/step_definitions/**/*.{js,ts}"
    ],
    "cucumberJson": {
      "generate": true,
      "outputFolder": "integration_tests/reports/cucumber-json",
      "filePrefix": "",
      "fileSuffix": ".cucumber"
    }
  },
  "overrides": {
    "sanitize-html": {
      "htmlparser2": "^10.1.0"
    },
    "glob": "^14.0.4",
    "deepmerge": "4.1.2",
    "eslint-plugin-import": {
      "minimatch": "^3.1.5"
    },
    "@badeball/cypress-cucumber-preprocessor": {
      "glob": "^14.0.4",
      "minimatch": "^11.0.5"
    },
    "jest": {
      "minimatch": "^11.0.5"
    },
    "find-cypress-specs": {
      "minimatch": "^11.0.5"
    },
    "eslint": {
      "minimatch": "^11.0.8"
    },
    "@eslint/config-array": {
      "minimatch": "^11.0.8"
    }
  }
}
